# Copier ce fichier en ".env" puis renseigner les valeurs. Ne jamais committer .env.

# Clé API Anthropic (Claude) - rédaction du compte rendu
# À créer sur https://platform.claude.com (Console Anthropic) > API keys
ANTHROPIC_API_KEY=

# Clé API Mistral AI - transcription audio (Voxtral)
# À créer sur https://console.mistral.ai > API keys
MISTRAL_API_KEY=

# Mot de passe d'accès à l'app (fortement recommandé dès qu'elle est en ligne)
# Le navigateur demandera un identifiant (n'importe lequel) et ce mot de passe.
APP_PASSWORD=

# Optionnel
PORT=3000
MAX_AUDIO_MB=300
# CLAUDE_MODEL=claude-opus-5-5
# MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
